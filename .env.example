# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env real al repositorio.

# Token del bot, obtenido de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# IDs numericos de Telegram de los profesores autorizados a abrir/cerrar el pase de lista,
# separados por comas. Para saber tu ID numerico, escribele a @userinfobot en Telegram.
TEACHER_IDS=

# Coordenadas del salon de clases y radio de tolerancia en metros
CLASSROOM_LAT=
CLASSROOM_LON=
CLASSROOM_RADIUS_METERS=50

# Duracion por defecto (minutos) de cada pase de lista si no se especifica en /pase
SESSION_DEFAULT_MINUTES=10

# Cadena de conexion a PostgreSQL. El host "db" corresponde al servicio de docker-compose.
# Debe usar el mismo usuario/password/base que POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB.
DATABASE_URL=postgresql://asistencia:CAMBIA_ESTA_PASSWORD@db:5432/asistencia

# Credenciales de la base de datos (usadas por el contenedor de PostgreSQL)
POSTGRES_DB=asistencia
POSTGRES_USER=asistencia
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD

# Nivel de logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Tag de la imagen a desplegar (se usa junto a docker compose pull)
IMAGE_TAG=latest

# Consulta de calificaciones (/calif). Si se dejan vacias, /calif responde que no esta disponible.
# La llave es una credencial de servidor (rol "bot" de la plataforma academica): NUNCA la subas al repositorio.
ACADEMIC_API_BASE_URL=
ACADEMIC_API_KEY=
# Opcional: timeout en segundos de cada consulta (por defecto 10)
# ACADEMIC_API_TIMEOUT_SECONDS=10
